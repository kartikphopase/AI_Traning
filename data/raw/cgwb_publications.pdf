		    display: flex;
		    align-items: center;
		    justify-content: center;
		}

		.overlay-spinner {
		    border: 6px solid #f3f3f3;
		    border-top: 6px solid #3498db;
		    border-radius: 50%;
		    width: 50px;
		    height: 50px;
		    animation: spin 1s linear infinite;
		}
		@keyframes spin {
		    0% { transform: rotate(0deg); }
