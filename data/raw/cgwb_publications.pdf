      <script>
         function handlePreloader() {
             if($('.preloader').length){
                 $('body').removeClass('active-preloader-ovh');
                 $('.preloader').fadeOut();
             }
         }
         
         
         jQuery(window).on('load', function() {
             (function($) {
                 handlePreloader()
         
                 // thmScrollAnim();
         
             })(jQuery);
         });
    
    var state_obj = $('#stateSelect');      
    if ($($this).val() != '' ) {
	    showSelectedStateOptions(state_obj, 'districtSelect');
	}     
function showSelectedStateOptions($this,district_test_id)
{
	var arr = $($this).val();
	document.getElementById('overlay-loader').style.display = 'flex';
	if(arr == 'All')
	{
		 var option ='';
		  var district_selected_id = "";
        if(district_selected_id == 'All')
            {
                selected = 'selected';
            }else{
                selected = '';
            }
		 option +='<option value="">Select District...</option>';
		option +='<option  '+selected+'  value="All">All</option>';
		 $('#'+district_test_id).html(option);
		 document.getElementById('overlay-loader').style.display = 'none';
	}else{
	$.ajax({
			url: "https://cgwb.gov.in/cgwbpnm/get-district",
			method: "POST",
			dataType: 'json',
			data: {
				'state_ids[]': arr,
				 
			},
			headers: {
				'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
			},
			success: function(result) {
				
				$('#'+district_test_id).html('');
				   var option ='';
				   var selected = '';
				   var district_selected_id = "";
				   option +='<option value="">Select District...</option>'; 
				   
				   if(result!=null){
						 $.each(result, function(i, item) {
						 
						if(district_selected_id == item.district_code)
						{
							selected = 'selected';
						}else{
							selected = '';
						}	 
                          option +="<option "+selected+" value='"+item.district_code+"'>"+item.district_name+"</option>";
                      });
				   }
				 $('#'+district_test_id).html(option);
				 document.getElementById('overlay-loader').style.display = 'none';
			}
		});
	}
}


function downloadPdf(publicationId, downloadUrl) {
	event.preventDefault();
	document.getElementById('overlay-loader').style.display = 'flex';
    fetch(`https://cgwb.gov.in/cgwbpnm/publication/${publicationId}`, {
        method: 'POST',
        headers: {
            'X-CSRF-TOKEN': 'XZsO144yJrd6q1O46DPXUoeG0wxtsz86DmB4XnSV',
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        },
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update download count UI
            document.getElementById('download-count-' + publicationId).innerText = data.new_count;

            // Trigger file download without redirect
            const link = document.createElement('a');
            link.href = downloadUrl;           
            link.download = ''; // Optional: specify filename or leave empty
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else {
            alert('Could not update download count.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Download failed.');
    })
    .finally(() => {
        // Hide loader no matter what
       document.getElementById('overlay-loader').style.display = 'none';
    });
}

      </script>
